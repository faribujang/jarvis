# .env.example — copy this file to `.env` and fill in your keys.
# `.env` is git-ignored; NEVER commit real keys. Only tools/llm.py reads these.

# Required: the default provider (Gemini 2.5 Flash via Google AI Studio).
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: OpenRouter (Qwen / Kimi / etc.). Needed only if you switch `active`
# in config/providers.yaml to an `openrouter/*` model.
# OPENROUTER_API_KEY=

# Optional: local models via Ollama need NO key. Run `ollama serve`, `ollama pull qwen2.5`,
# and set `active` to an `ollama/*` model. Only override the endpoint if it isn't the default.
# OLLAMA_API_BASE=http://localhost:11434
